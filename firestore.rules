rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Lookup profil user sendiri di koleksi 'users' (dibuat manual lewat
    // Firebase Console — lihat README §2.2 & §10). Dipakai berulang kali di
    // bawah untuk cek role & producerId tanpa perlu custom claims/Cloud Function.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myProfile().role : '';
    }

    function myProducerId() {
      return isSignedIn() ? myProfile().producerId : '';
    }

    function isStaff() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'kasir');
    }

    function isProducer() {
      return isSignedIn() && myRole() == 'produsen';
    }

    // USERS: hanya boleh baca dokumen milik sendiri (dibutuhkan utk load
    // profil saat login). TIDAK ADA update/delete dari client sama sekali —
    // role tidak bisa diubah sendiri setelah dibuat. CREATE diizinkan HANYA
    // lewat alur registrasi mandiri dengan kode undangan yang valid (lihat
    // validRegistration di bawah) — ini menggantikan cara lama (dibuat manual
    // 100% lewat Firebase Console); keduanya tetap bisa dipakai berdampingan.
    function validRegistration(uid) {
      let data = request.resource.data;
      let code = get(/databases/$(database)/documents/inviteCodes/$(data.inviteCodeUsed)).data;
      return isSignedIn() && request.auth.uid == uid
        && data.role in ['kasir', 'produsen']
        && code.used == false
        && code.isActive == true
        && code.type == data.role
        && data.lapakIds == code.lapakIds
        && (data.role != 'produsen' || data.producerId == code.producerId);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if validRegistration(uid);
      allow update, delete: if false;
    }

    // INVITE CODES: staf yang generate (create/nonaktifkan). Siapa pun yang
    // SUDAH login (termasuk user yang baru saja daftar via Firebase Auth,
    // sebelum py dokumen profil) boleh BACA kode (perlu utk validasi saat
    // registrasi) dan menandainya "used" — tapi HANYA boleh mengubah field
    // used/usedBy/usedAt utk uid dirinya sendiri, tidak bisa mengubah field
    // lain (lapakId, producerId, dst) atau menandai "used" atas nama orang lain.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isStaff()
        || (isSignedIn()
            && resource.data.used == false
            && request.resource.data.used == true
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.type == resource.data.type
            && request.resource.data.lapakId == resource.data.lapakId
            && request.resource.data.producerId == resource.data.producerId
            && request.resource.data.lapakIds == resource.data.lapakIds);
      allow delete: if isStaff();
    }

    match /lapak/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // PRODUCERS: staf lihat semua (perlu utk Master Data & pilih produsen
    // saat bikin titipan). Produsen HANYA boleh lihat data dirinya sendiri —
    // supaya tidak bisa mengintip kontak/harga produsen lain.
    match /producers/{id} {
      allow read: if isStaff() || (isProducer() && id == myProducerId());
      allow write: if isStaff();
    }

    // PRODUCTS: sama polanya — produsen hanya lihat katalog produknya sendiri.
    match /products/{id} {
      allow read: if isStaff() || (isProducer() && resource.data.producerId == myProducerId());
      allow write: if isStaff();
    }

    match /consignments/{consignmentId} {
      allow read: if isStaff() || (isProducer() && resource.data.producerId == myProducerId());

      // Staf boleh bikin titipan status apa saja (biasanya langsung 'active').
      // Produsen HANYA boleh bikin utk producerId miliknya sendiri, dan WAJIB
      // berstatus 'pending' — tidak boleh langsung 'active' tanpa konfirmasi
      // staf (ini yang menjaga kontrol silang titipan vs fisik barang).
      allow create: if isStaff()
        || (isProducer()
            && request.resource.data.producerId == myProducerId()
            && request.resource.data.status == 'pending');

      // Update: staf bebas (konfirmasi/tolak/tutup/bayar). Produsen HANYA
      // boleh update titipan miliknya sendiri SELAMA MASIH 'pending' dan
      // TIDAK mengubah status-nya sendiri (mencegah produsen self-approve).
      allow update: if isStaff()
        || (isProducer()
            && resource.data.producerId == myProducerId()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending');

      allow delete: if isStaff();

      match /items/{itemId} {
        function parentConsignment() {
          return get(/databases/$(database)/documents/consignments/$(consignmentId)).data;
        }

        allow read: if isStaff() || (isProducer() && parentConsignment().producerId == myProducerId());

        allow create: if isStaff()
          || (isProducer()
              && parentConsignment().producerId == myProducerId()
              && parentConsignment().status == 'pending');

        allow update: if isStaff()
          || (isProducer()
              && parentConsignment().producerId == myProducerId()
              && parentConsignment().status == 'pending');

        allow delete: if isStaff();
      }
    }

    // SALES & PAYMENT: data finansial internal lapak — produsen TIDAK
    // diberi akses sama sekali ke sini (mereka lihat stok terjual lewat
    // qtySold di consignments/items, cukup utk kebutuhan monitoring mereka,
    // tanpa membuka detail transaksi per pembeli/produsen lain).
    match /salesTransactions/{id} {
      allow read, write: if isStaff();
      match /items/{itemId} {
        allow read, write: if isStaff();
      }
    }

    // PESANAN TERJADWAL: murni internal staf lapak, tidak ada kaitan dgn
    // akses produsen sama sekali (harga jual/cost customer bukan urusan
    // produsen individual).
    match /preorders/{id} {
      allow read, write: if isStaff();
      match /items/{itemId} {
        allow read, write: if isStaff();
      }
    }
  }
}
